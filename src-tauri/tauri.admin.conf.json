{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "million-dollars-admin",
  "version": "0.1.0",
  "identifier": "com.tauri-app.million-dollars-admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/admin.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "million-dollars-admin",
        "url": "admin.html",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
