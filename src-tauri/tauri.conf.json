{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "million-dollars-music",
  "version": "0.1.0",
  "identifier": "com.tauri-app.million-dollars-music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "million-dollars-music",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://5.181.21.13:8000; img-src 'self' asset: http://asset.localhost data: blob: http: https:; media-src 'self' data: blob: http://5.181.21.13:8000; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
